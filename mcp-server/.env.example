# Supabase project URL (same as NEXT_PUBLIC_SUPABASE_URL in the app)
SUPABASE_URL=https://bxsbkraloitwcaiyaemw.supabase.co

# Supabase SERVICE ROLE key — get from: Supabase Dashboard > Settings > API > service_role
