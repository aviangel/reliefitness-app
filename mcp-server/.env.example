# Supabase project URL
SUPABASE_URL=https://bxsbkraloitwcaiyaemw.supabase.co

# Supabase SERVICE ROLE key (Settings → API → service_role). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Your Supabase user ID (Authentication → Users → your UID)
HEALTH_USER_ID=your_user_id_here

# A strong random token used as the OAuth access token and Bearer auth.
# Generate with: openssl rand -hex 32
MCP_ACCESS_TOKEN=your_random_secret_token_here

# Port for the HTTP server (Railway sets this automatically)
PORT=3001
